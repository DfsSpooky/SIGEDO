# ------------------------------------------------------------------------------
# SIGEDO - Plantilla de Configuración del Entorno (.env)
# Copia este archivo como '.env' y ajusta los valores según tu entorno.
# ------------------------------------------------------------------------------

# --- SEGURIDAD DJANGO ---
# Genera una clave segura para producción.
SECRET_KEY='django-insecure-tu-clave-aqui'

# Define si el modo depuración está activo (True/False).
# IMPORTANTE: En producción siempre debe ser False.
DEBUG=True

# Lista de hosts permitidos separados por comas.
# Ej: localhost,127.0.0.1,tudominio.com
ALLOWED_HOSTS=localhost,127.0.0.1


# --- BASE DE DATOS (Opcional - PostgreSQL) ---
# Si no se definen estas variables, el sistema usará SQLite por defecto (db.sqlite3).
# POSTGRES_DB=sigedo_db
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=tu_password
# DB_HOST=db
# DB_PORT=5432


# --- CACHE Y WEBSOCKETS (Redis) ---
# Necesario para notificaciones en tiempo real.
REDIS_HOST=localhost
REDIS_PORT=6379


# --- FIREBASE (Notificaciones Push) ---
# Puedes configurar Firebase de tres maneras (elige una):

# 1. Contenido completo del JSON (Recomendado para Docker/Vercel/Render)
# FIREBASE_SERVICE_ACCOUNT_JSON='{"type": "service_account", "project_id": "...", ...}'

# 2. Ruta absoluta al archivo JSON descargado de Firebase Console
# FIREBASE_SERVICE_ACCOUNT_PATH='/home/usuario/sigedo/serviceAccountKey.json'

# 3. Archivo por defecto (Si no llenas ninguna, el código buscará 'serviceAccountKey.json' en la raíz)


# --- INTELIGENCIA ARTIFICIAL (Opcional) ---
# Clave de API para el planificador con IA (Google Gemini).
GEMINI_API_KEY=tu_api_key_aqui


# --- OTROS ---
# Clave base para encriptación de IDs sensibles (32 caracteres recomendados).
ID_ENCRYPTION_KEY='una-clave-de-32-caracteres-exactos'
