# ------------------------------------------------------------------------------
# SIGEDO - Plantilla de entorno
# Copia este archivo como `.env` para desarrollo local o como base del entorno
# de producción en Hestia/servidor.
# ------------------------------------------------------------------------------

# --- ENTORNO ---
DJANGO_ENV=local
DEBUG=True
APP_DOMAIN=localhost

# --- SEGURIDAD DJANGO ---
# En producción usa claves reales y únicas.
SECRET_KEY=replace-with-a-secure-secret-key
ID_ENCRYPTION_KEY=replace-with-a-32-byte-base64-key
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1
ENABLE_API_DOCS=True
X_FRAME_OPTIONS=SAMEORIGIN

# --- RUTAS DE ARCHIVOS ---
# En Hestia cambia PUBLIC_ROOT a la carpeta public_html del dominio.
PUBLIC_ROOT=/absolute/path/to/public_html
STATIC_URL=/static/
MEDIA_URL=/media/
# STATIC_ROOT=/absolute/path/to/public_html/static
# MEDIA_ROOT=/absolute/path/to/public_html/media

# --- BASE DE DATOS ---
# Local simple: deja PostgreSQL vacío y el sistema usará SQLite.
# SQLITE_PATH=/absolute/path/to/gestion_docentes/db.sqlite3

# Producción/PostgreSQL:
# POSTGRES_DB=sigedo
# POSTGRES_USER=sigedo_user
# POSTGRES_PASSWORD=change-me
# POSTGRES_HOST=127.0.0.1
# POSTGRES_PORT=5432
# DB_CONN_MAX_AGE=60

# --- CACHE / CHANNELS ---
# Si no defines REDIS_HOST, en local con DEBUG=True se usará memoria.
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379

# --- CORREO ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_HOST=smtp.tu-dominio.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=no-reply@tu-dominio.com
# EMAIL_HOST_PASSWORD=change-me
# EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@sigedo.local
SERVER_EMAIL=no-reply@sigedo.local

# --- FIREBASE ---
# Producción: usa JSON inline o ruta absoluta fuera del repo.
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account", ...}
# FIREBASE_SERVICE_ACCOUNT_PATH=/absolute/path/outside/repo/serviceAccountKey.json
ALLOW_LOCAL_FIREBASE_FILE=True

# --- IA (Opcional) ---
GEMINI_API_KEY=

# --- SEGURIDAD WEB ---
SECURE_SSL_REDIRECT=False
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True
SESSION_COOKIE_SAMESITE=Lax
CSRF_COOKIE_SAMESITE=Lax

# --- LOGS ---
LOG_LEVEL=INFO
