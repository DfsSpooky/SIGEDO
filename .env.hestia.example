# ------------------------------------------------------------------------------
# SIGEDO - Producción Docker detrás de Hestia
# VPS: Debian / OVH
# Usuario del panel Hestia: sigedo
# Dominio: sigedo.ddnsgeek.com
# ------------------------------------------------------------------------------

DJANGO_ENV=production
DEBUG=False
APP_DOMAIN=sigedo.ddnsgeek.com
APP_ENV_FILE=.env

# --- SEGURIDAD ---
SECRET_KEY=replace-with-a-secure-secret-key
ID_ENCRYPTION_KEY=replace-with-a-32-byte-base64-key
ALLOWED_HOSTS=sigedo.ddnsgeek.com
CSRF_TRUSTED_ORIGINS=https://sigedo.ddnsgeek.com
ENABLE_API_DOCS=False
X_FRAME_OPTIONS=DENY

# --- RUTAS DENTRO DEL CONTENEDOR ---
# Hestia servira static/media desde el host, pero Docker escribira aqui adentro.
PUBLIC_ROOT=/app/public_html
STATIC_URL=/static/
MEDIA_URL=/media/
STATIC_ROOT=/app/public_html/static
MEDIA_ROOT=/app/public_html/media

# --- BASE DE DATOS ---
POSTGRES_DB=sigedo
POSTGRES_USER=sigedo_user
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_HOST=db
POSTGRES_PORT=5432
DB_CONN_MAX_AGE=60

# --- REDIS / CHANNELS ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- CORREO ---
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.tu-dominio.com
EMAIL_PORT=587
EMAIL_HOST_USER=no-reply@sigedo.ddnsgeek.com
EMAIL_HOST_PASSWORD=replace-with-email-password
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=no-reply@sigedo.ddnsgeek.com
SERVER_EMAIL=no-reply@sigedo.ddnsgeek.com

# --- FIREBASE ---
FIREBASE_SERVICE_ACCOUNT_PATH=/run/secrets/serviceAccountKey.json
ALLOW_LOCAL_FIREBASE_FILE=False

# --- IA (OPCIONAL) ---
GEMINI_API_KEY=

# --- SEGURIDAD WEB ---
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True
SESSION_COOKIE_SAMESITE=Lax
CSRF_COOKIE_SAMESITE=Lax

# --- LOGS ---
LOG_LEVEL=INFO

# --- RUTAS DEL HOST PARA DOCKER COMPOSE PROD ---
HOST_PUBLIC_HTML=/home/sigedo/web/sigedo.ddnsgeek.com/public_html
HOST_STATIC_DIR=/home/sigedo/web/sigedo.ddnsgeek.com/public_html/static
HOST_MEDIA_DIR=/home/sigedo/web/sigedo.ddnsgeek.com/public_html/media
HOST_FIREBASE_KEY=/home/sigedo/.secrets/serviceAccountKey.json
